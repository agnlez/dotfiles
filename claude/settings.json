{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-8",
  "skillListingBudgetFraction": 0.03,
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Read",
      "Read(.env.test)",
      "Read(.env.test.containers)",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git branch:*)",
      "Bash(git branch -d*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git config:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(curl:*)",
      "Bash(gh:*)",
      "Bash(jq:*)",
      "Bash(bat:*)",
      "Bash(eza:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(lsof:*)",
      "mcp__plugin_context7_context7",
      "mcp__plugin_figma_figma",
      "mcp__plugin_playwright_playwright",
      "mcp__next-devtools",
      "mcp__plugin_atlassian_atlassian"
    ],
    "deny": ["Read(.env*)", "Edit(.env*)"],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout --*)",
      "Bash(gh pr close*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo delete*)",
      "mcp__plugin_atlassian_atlassian__createJiraIssue",
      "mcp__plugin_atlassian_atlassian__editJiraIssue",
      "mcp__plugin_atlassian_atlassian__transitionJiraIssue",
      "mcp__plugin_atlassian_atlassian__addCommentToJiraIssue",
      "mcp__plugin_atlassian_atlassian__addWorklogToJiraIssue",
      "mcp__plugin_atlassian_atlassian__createConfluencePage",
      "mcp__plugin_atlassian_atlassian__updateConfluencePage",
      "mcp__plugin_atlassian_atlassian__createIssueLink"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/optimize-images/check-committed-images.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "vizz-core@vizzuality": true,
    "figma@claude-plugins-official": true,
    "modern-web-guidance@googlechrome": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "vizzuality": {
      "source": {
        "source": "github",
        "repo": "Vizzuality/claude-code-standards"
      },
      "autoUpdate": true
    },
    "googlechrome": {
      "source": {
        "source": "github",
        "repo": "GoogleChrome/modern-web-guidance"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "theme": "dark-ansi",
  "skipAutoPermissionPrompt": true,
  "defaultMode": "acceptEdits"
}
