      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git config:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(gh:*)",
      "Bash(jq:*)",
      "Bash(bat:*)",
      "Bash(eza:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(yq:*)",
      "Bash(lsof:*)",
      "Bash(pnpx modern-web-guidance@latest:*)",
      "PowerShell(git add:*)",
      "PowerShell(git commit:*)",
      "PowerShell(git fetch:*)",
      "PowerShell(git pull:*)",
      "PowerShell(git push:*)",
      "PowerShell(git branch:*)",
      "PowerShell(git branch -d*)",
      "PowerShell(git checkout:*)",
      "PowerShell(git merge:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git tag:*)",
      "PowerShell(git config:*)",
      "PowerShell(git log:*)",
      "PowerShell(git diff:*)",
      "PowerShell(git show:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git cherry-pick:*)",
      "PowerShell(git revert:*)",
      "PowerShell(pnpm:*)",
      "PowerShell(npm:*)",
      "PowerShell(gh:*)",
      "PowerShell(jq:*)",
      "PowerShell(bat:*)",
      "PowerShell(eza:*)",
      "PowerShell(rg:*)",
      "PowerShell(fd:*)",
      "PowerShell(yq:*)",
      "mcp__plugin_context7_context7",
      "mcp__plugin_figma_figma",
      "mcp__plugin_playwright_playwright",
      "mcp__next-devtools",
      "mcp__plugin_atlassian_atlassian"
    ],
    "deny": ["Read(.env*)", "Read(!.env.test)", "Read(!.env.test.containers)", "Edit(.env*)"],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout --*)",
      "Bash(gh pr close*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit *)",
      "Bash(gh gist create *)",
      "Bash(gh secret *)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm create *)",
      "Bash(pnpm publish*)",
      "Bash(npm exec *)",
      "Bash(npm x *)",
      "Bash(npm init *)",
      "Bash(npm create *)",
      "Bash(npm publish*)",
      "Bash(bat *.env*)",
      "Bash(jq *.env*)",
      "Bash(yq *.env*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *+*)",
      "PowerShell(git push *--delete*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git checkout --*)",
      "PowerShell(gh pr close*)",
      "PowerShell(gh pr merge*)",
      "PowerShell(gh issue close*)",
      "PowerShell(gh issue delete*)",
      "PowerShell(gh repo delete*)",
      "PowerShell(gh repo edit *)",
      "PowerShell(gh gist create *)",
      "PowerShell(gh secret *)",
      "PowerShell(gh api *-X*)",
      "PowerShell(gh api *--method*)",
      "PowerShell(gh api *-f *)",
      "PowerShell(gh api *-F *)",
      "PowerShell(gh api *--field*)",
      "PowerShell(gh api *--raw-field*)",
      "PowerShell(gh api *--input*)",
      "PowerShell(pnpm dlx *)",
      "PowerShell(pnpm create *)",
      "PowerShell(pnpm publish*)",
      "PowerShell(npm exec *)",
      "PowerShell(npm x *)",
      "PowerShell(npm init *)",
      "PowerShell(npm create *)",
      "PowerShell(npm publish*)",
      "PowerShell(bat *.env*)",
      "PowerShell(jq *.env*)",
      "PowerShell(yq *.env*)",
      "mcp__plugin_atlassian_atlassian__createJiraIssue",
      "mcp__plugin_atlassian_atlassian__editJiraIssue",
      "mcp__plugin_atlassian_atlassian__transitionJiraIssue",
      "mcp__plugin_atlassian_atlassian__addOrEditJiraIssueComment",
      "mcp__plugin_atlassian_atlassian__createConfluenceContent",
      "mcp__plugin_atlassian_atlassian__updateConfluenceContent",
      "mcp__plugin_atlassian_atlassian__executeWrite",
      "mcp__plugin_atlassian_atlassian__executeDestructive"
    ],
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "vizz-core@vizzuality": true,
    "figma@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "vizz-maps@vizzuality": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "vizzuality": {
      "source": {
        "source": "github",
        "repo": "Vizzuality/claude-code-standards"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true,
  "feedbackDrafts": "off",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
