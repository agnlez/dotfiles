{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.03,
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git branch:*)",
      "Bash(git branch -d*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(git config:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git rebase:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(gh:*)",
      "Bash(jq:*)",
      "Bash(bat:*)",
      "Bash(eza:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(yq:*)",
      "Bash(lsof:*)",
      "mcp__plugin_context7_context7",
      "mcp__plugin_figma_figma",
      "mcp__plugin_playwright_playwright",
      "mcp__next-devtools",
      "mcp__plugin_atlassian_atlassian"
    ],
    "deny": ["Read(.env*)", "Read(!.env.test)", "Read(!.env.test.containers)", "Edit(.env*)"],
    "ask": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)",
      "Bash(git push *--delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git checkout --*)",
      "Bash(gh pr close*)",
      "Bash(gh pr merge*)",
      "Bash(gh issue close*)",
      "Bash(gh issue delete*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo edit *)",
      "Bash(gh gist create *)",
      "Bash(gh secret *)",
      "Bash(gh api *-X*)",
      "Bash(gh api *--method*)",
      "Bash(gh api *-f *)",
      "Bash(gh api *-F *)",
      "Bash(gh api *--field*)",
      "Bash(gh api *--raw-field*)",
      "Bash(gh api *--input*)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm create *)",
      "Bash(pnpm publish*)",
      "Bash(npm exec *)",
      "Bash(npm x *)",
      "Bash(npm init *)",
      "Bash(npm create *)",
      "Bash(npm publish*)",
      "Bash(bat *.env*)",
      "Bash(jq *.env*)",
      "Bash(yq *.env*)",
      "mcp__plugin_atlassian_atlassian__createJiraIssue",
      "mcp__plugin_atlassian_atlassian__editJiraIssue",
      "mcp__plugin_atlassian_atlassian__transitionJiraIssue",
      "mcp__plugin_atlassian_atlassian__addOrEditJiraIssueComment",
      "mcp__plugin_atlassian_atlassian__createConfluenceContent",
      "mcp__plugin_atlassian_atlassian__updateConfluenceContent",
      "mcp__plugin_atlassian_atlassian__executeWrite",
      "mcp__plugin_atlassian_atlassian__executeDestructive"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "vizz-core@vizzuality": true,
    "figma@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "vizzuality": {
      "source": {
        "source": "github",
        "repo": "Vizzuality/claude-code-standards"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "skipAutoPermissionPrompt": true
}
