[gpg]
	format = ssh
# The signing program (op-ssh-sign) differs per OS: see ~/.gitconfig.os.
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[core]
	excludesFile = ~/.gitignore
	pager = delta
[push]
	autoSetupRemote = true
	default = current
[alias]
	lg = log --graph --format=\"%C(yellow)%h%C(reset) %C(magenta)%s%C(reset)%C(red)%d%C(reset) %C(cyan)%ad%C(reset) %C(blue)%an%C(reset)\" --date=short
	lga = log --graph --all --format=\"%C(yellow)%h%C(reset) %C(magenta)%s%C(reset)%C(red)%d%C(reset) %C(cyan)%ad%C(reset) %C(blue)%an%C(reset)\" --date=short
	aliases = config --get-regexp ^alias\\.
	undo = reset --soft HEAD~1
	oops = commit --amend --no-edit
[pull]
	rebase = true
[rebase]
	autoStash = true
[fetch]
	prune = true
	pruneTags = true
[rerere]
	enabled = true
	autoUpdate = true
[diff]
	algorithm = histogram
	colorMoved = default
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
	gpgSign = true
[init]
	defaultBranch = main
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	dark = true
[merge]
	conflictStyle = zdiff3
[column]
	ui = auto
[help]
	autoCorrect = prompt
[commit]
	gpgsign = true
# Last, so they override everything above, in this order:
# - ~/.gitconfig.os: the installer links git/.gitconfig.macos or
#   git/.gitconfig.windows here, for values that differ per OS.
# - ~/.gitconfig.local: untracked, per-machine values (identity, overrides).
[include]
	path = ~/.gitconfig.os
	path = ~/.gitconfig.local
