# Machine-specific git config — copy this to ~/.gitconfig.local and fill in.
# This file is loaded via [include] at the bottom of ~/.gitconfig, so values
# here OVERRIDE anything defined in the tracked gitconfig.

[user]
	name = Your Name
	email = you@example.com
	signingkey = ~/.ssh/id_ed25519.pub

# SSH commit signing via 1Password. Adjust the program path if 1Password is
# installed outside /Applications. The allowedSignersFile must exist and list
# the public keys you want to trust for verification.
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
	allowedSignersFile = ~/.config/git/allowed_signers

[commit]
	gpgsign = true
