# Machine-specific git config — copy this to ~/.gitconfig.local and fill in.
# This file is loaded via [include] at the bottom of ~/.gitconfig, after
# ~/.gitconfig.os, so values here OVERRIDE both.

# The signing key lives in 1Password, not on disk, so `signingkey` holds the
# public key itself (copy it from the key's 1Password item), prefixed with
# `key::`.
[user]
	name = Your Name
	email = you@example.com
	signingkey = key::ssh-ed25519 AAAA…

# The tracked gitconfig reads trusted keys from ~/.config/git/allowed_signers,
# and the per-OS file sets 1Password's signer. Uncomment only to override them,
# e.g. when 1Password is installed outside its default location.
# [gpg "ssh"]
# 	allowedSignersFile = ~/path/to/allowed_signers
# 	program = /path/to/op-ssh-sign
